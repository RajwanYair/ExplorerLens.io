{
  "inputs": [
    {
      "type": "promptString",
      "id": "github-token",
      "description": "GitHub Personal Access Token for MCP server",
      "password": true
    }
  ],
  "servers": {
    "github": {
      "command": "${env:ProgramFiles}\\nodejs\\npx.cmd",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github-token}",
        "PATH": "${env:PROGRAMFILES}\\nodejs;${env:PROGRAMFILES}\\Git\\cmd;${env:PROGRAMDATA}\\scoop\\shims;${env:PATH}"
      }
    },
    "filesystem": {
      "command": "${env:ProgramFiles}\\nodejs\\npx.cmd",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ],
      "env": {
        "PATH": "${env:PROGRAMFILES}\\nodejs;${env:PROGRAMFILES}\\Git\\cmd;${env:PROGRAMDATA}\\scoop\\shims;${env:PATH}"
      }
    },
    "project-docs": {
      "command": "${env:ProgramFiles}\\nodejs\\npx.cmd",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}\\.github",
        "${workspaceFolder}\\docs"
      ],
      "env": {
        "PATH": "${env:PROGRAMFILES}\\nodejs;${env:PROGRAMFILES}\\Git\\cmd;${env:PROGRAMDATA}\\scoop\\shims;${env:PATH}"
      }
    }
  }
}
